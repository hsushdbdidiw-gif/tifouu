                      onClick={() => showToast('تم حفظ إعدادات الدفع الخاصة بمتجرك بنجاح!')}
                      className="w-full bg-slate-800 hover:bg-slate-700 text-white font-bold py-3 rounded-xl text-xs sm:text-sm transition-colors cursor-pointer"
                    >
                      حفظ بيانات الدفع (بريدي موب & ريدوت باي)
                    </button>
                  </div>
                </div>

                {/* قائمة المنتجات التي أضافها البائع */}
                <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 space-y-4">
                  <h4 className="font-bold text-white text-base flex items-center justify-between">
                    <span>منتجاتك المنشورة حديثاً</span>
                    <span className="text-xs text-emerald-400">{mySellerProducts.length} منتج</span>
                  </h4>

                  {mySellerProducts.length === 0 ? (
                    <p className="text-xs text-slate-400 py-4 text-center">
                      لم تقم بإضافة منتجات جديدة في هذه الجلسة بعد. استخدم النموذج لنشر أول منتج!
                    </p>
                  ) : (
                    <div className="space-y-3">
                      {mySellerProducts.map((item) => (
                        <div
                          key={item.id}
                          className="p-3.5 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-3"
                        >
                          <div>
                            <p className="text-sm font-bold text-white line-clamp-1">{item.title}</p>
                            <span className="text-xs text-emerald-400 font-bold">
                              {item.price.toLocaleString('ar-DZ')} د.ج
                            </span>
                          </div>
                          <button
                            onClick={() => handleDeleteProduct(item.id)}
                            className="p-2 text-rose-400 hover:bg-rose-500/10 rounded-lg transition-colors"
                            title="حذف المنتج"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ================= 3. تبويب مشترياتي وتحميل الملفات (MY PURCHASES) ================= */}
        {activeTab === 'purchases' && (
          <div className="space-y-6">
            <div className="bg-slate-900 border border-slate-800 rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
              <div>
                <h2 className="text-2xl font-black text-white">مكتبة مشترياتي الرقمية</h2>
                <p className="text-sm text-slate-400 mt-1">
                  جميع المنتجات الرقمية التي قمت بشرائها متاحة للتحميل المباشر في أي وقت.
                </p>
              </div>
              <button
                onClick={() => setActiveTab('marketplace')}
                className="bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-bold px-5 py-3 rounded-xl transition-all cursor-pointer"
              >
                تصفح المزيد من المنتجات
              </button>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {purchasedItems.map((item, index) => (
                <div
                  key={`${item.id}-${index}`}
                  className="bg-slate-900 border border-slate-800 rounded-3xl p-6 flex flex-col justify-between gap-5"
                >
                  <div className="flex items-start gap-4">
                    <div className={`w-14 h-14 rounded-2xl bg-gradient-to-br ${item.gradient} flex items-center justify-center shrink-0`}>
                      {renderProductIcon(item.iconType)}
                    </div>
                    <div className="space-y-1.5">
                      <span className="inline-block text-[11px] font-bold px-2.5 py-0.5 rounded-md bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                        مدفوع ومفعل ✓
                      </span>
                      <h3 className="text-base sm:text-lg font-extrabold text-white">
                        {item.title}
                      </h3>
                      <p className="text-xs text-slate-400">
                        البائع: {item.sellerName} • الصيغة: {item.fileFormat}
                      </p>
                    </div>
                  </div>

                  <div className="bg-slate-950 border border-slate-800/80 rounded-2xl p-3.5 text-xs grid grid-cols-2 gap-2 text-slate-300">
                    <div>
                      <span className="text-slate-500 block">وسيلة الدفع:</span>
                      <strong className="text-amber-300">{item.paymentMethod}</strong>
                    </div>
                    <div>
                      <span className="text-slate-500 block">مرجع العملية:</span>
                      <strong className="font-mono text-emerald-400">{item.transactionRef}</strong>
                    </div>
                  </div>

                  <button
                    onClick={() => triggerDigitalDownload(item)}
                    className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black py-3.5 rounded-xl flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/20 transition-all cursor-pointer"
                  >
                    <Download className="w-5 h-5" />
                    <span>تحميل المنتج الرقمي الآن ({item.fileSize})</span>
                  </button>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>

      {/* ================= نافذة معاينة تفاصيل المنتج (Preview Modal) ================= */}
      {previewProduct && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-slate-900 border border-slate-800 rounded-3xl max-w-xl w-full p-6 sm:p-8 space-y-6 relative shadow-2xl">
            <button
              onClick={() => setPreviewProduct(null)}
              className="absolute left-5 top-5 p-2 rounded-full bg-slate-800 text-slate-400 hover:text-white"
            >
              <X className="w-5 h-5" />
            </button>

            <div className="flex items-center gap-3">
              <span className="px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-300">
                {previewProduct.category}
              </span>
              <span className="text-xs text-amber-400 font-bold">
                ★ {previewProduct.rating} ({previewProduct.sales} مبيعة)
              </span>
            </div>

            <h3 className="text-xl sm:text-2xl font-black text-white">
              {previewProduct.title}
            </h3>

            <p className="text-sm text-slate-300 leading-relaxed">
              {previewProduct.description}
            </p>

            <div className="bg-slate-950 border border-slate-800 rounded-2xl p-4 grid grid-cols-2 gap-4 text-xs">
              <div>
                <span className="text-slate-500 block">البائع:</span>
                <strong className="text-white">{previewProduct.sellerName}</strong>
              </div>
              <div>
                <span className="text-slate-500 block">صيغة وحجم الملف:</span>
                <strong className="text-emerald-400">{previewProduct.fileFormat} ({previewProduct.fileSize})</strong>
              </div>
            </div>

            <div className="flex items-center justify-between pt-2">
              <div>
                <span className="text-xs text-slate-400 block">السعر</span>
                <span className="text-2xl font-black text-emerald-400">
                  {previewProduct.price.toLocaleString('ar-DZ')} د.ج
                </span>
              </div>
              <button
                onClick={() => {
                  const prod = previewProduct;
                  setPreviewProduct(null);
                  openCheckout(prod);
                }}
                className="bg-emerald-600 hover:bg-emerald-500 text-white font-black px-6 py-3.5 rounded-xl shadow-lg shadow-emerald-600/25 cursor-pointer"
              >
                شراء الآن عبر بريدي موب / ريدوت باي
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ================= نافذة الدفع التفاعلية (BaridiMob & RedotPay Checkout Modal) ================= */}
      {checkoutProduct && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-slate-900 border border-slate-700/80 rounded-3xl max-w-xl w-full p-6 sm:p-8 space-y-6 relative shadow-2xl my-8">
            {/* زر الإغلاق */}
            <button
              onClick={() => setCheckoutProduct(null)}
              className="absolute left-5 top-5 p-2 rounded-full bg-slate-800 text-slate-400 hover:text-white transition-colors cursor-pointer"
            >
              <X className="w-5 h-5" />
            </button>

            {!checkoutSuccess ? (
              <>
                {/* عنوان النافذة */}
                <div className="space-y-1">
                  <div className="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-400">
                    <Lock className="w-3.5 h-3.5" />
                    <span>بوابة الدفع الرقمي الآمن - وان كليك الجزائر</span>
                  </div>
                  <h3 className="text-xl font-black text-white">إتمام شراء المنتج الرقمي</h3>
                </div>

                {/* ملخص المنتج المختار */}
                <div className="bg-slate-950 border border-slate-800 rounded-2xl p-4 flex items-center justify-between gap-4">
                  <div className="space-y-1">
                    <p className="text-sm font-bold text-white line-clamp-1">
                      {checkoutProduct.title}
                    </p>
                    <p className="text-xs text-slate-400">
                      البائع: {checkoutProduct.sellerName}
                    </p>
                  </div>
                  <div className="text-left shrink-0">
                    <span className="text-xl font-black text-emerald-400">
                      {checkoutProduct.price.toLocaleString('ar-DZ')} د.ج
                    </span>
                    <span className="block text-[11px] text-slate-400">
                      ≈ {convertDzdToUsdt(checkoutProduct.price)} USDT
                    </span>
                  </div>
                </div>

                {/* اختيار وسيلة الدفع: بريدي موب أو ريدوت باي */}
                <div className="space-y-2.5">
                  <label className="text-xs font-bold text-slate-300 block">
                    اختر طريقة الدفع المفضلة لديك:
                  </label>
                  <div className="grid grid-cols-2 gap-3">
                    <button
                      type="button"
                      onClick={() => setPaymentMethod('baridimob')}
                      className={`p-4 rounded-2xl border text-right transition-all flex flex-col gap-1.5 cursor-pointer ${
                        paymentMethod === 'baridimob'
                          ? 'bg-amber-500/15 border-amber-400 text-white shadow-lg shadow-amber-500/10'
                          : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <Smartphone className="w-5 h-5 text-amber-400" />
                        {paymentMethod === 'baridimob' && (
                          <CheckCircle2 className="w-4 h-4 text-amber-400" />
                        )}
                      </div>
                      <span className="font-black text-sm text-amber-300">بريدي موب (BaridiMob)</span>
                      <span className="text-[11px] text-slate-400">تحويل RIP / CCP بالدينار</span>
                    </button>

                    <button
                      type="button"
                      onClick={() => setPaymentMethod('redotpay')}
                      className={`p-4 rounded-2xl border text-right transition-all flex flex-col gap-1.5 cursor-pointer ${
                        paymentMethod === 'redotpay'
                          ? 'bg-rose-500/15 border-rose-400 text-white shadow-lg shadow-rose-500/10'
                          : 'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700'
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <CreditCard className="w-5 h-5 text-rose-400" />
                        {paymentMethod === 'redotpay' && (
                          <CheckCircle2 className="w-4 h-4 text-rose-400" />
                        )}
                      </div>
                      <span className="font-black text-sm text-rose-300">ريدوت باي (RedotPay)</span>
                      <span className="text-[11px] text-slate-400">تحويل فوري عبر RedotPay ID</span>
                    </button>
                  </div>
                </div>

                {/* تفاصيل التحويل حسب الوسيلة المختارة */}
                {paymentMethod === 'baridimob' ? (
                  <div className="bg-amber-500/10 border border-amber-500/30 rounded-2xl p-4 space-y-3">
                    <div className="flex items-center justify-between text-xs text-amber-200">
                      <span className="font-bold">بيانات التحويل عبر تطبيق بريدي موب (RIP):</span>
                      <span className="bg-amber-400/20 px-2 py-0.5 rounded text-[11px]">بريد الجزائر</span>
                    </div>
                    <div className="bg-slate-950 border border-slate-800 rounded-xl p-3 flex items-center justify-between gap-2">
                      <div>
                        <span className="text-[11px] text-slate-400 block">رقم RIP الخاص بالبائع:</span>
                        <span className="font-mono text-sm sm:text-base font-bold text-amber-300 tracking-wide">
                          {checkoutProduct.sellerRip}
                        </span>
                      </div>
                      <button
                        type="button"
                        onClick={() => handleCopy(checkoutProduct.sellerRip, 'rip')}
                        className="px-3 py-2 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 text-xs font-bold flex items-center gap-1.5 cursor-pointer"
                      >
                        {copiedText === 'rip' ? <Check className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                        <span>{copiedText === 'rip' ? 'تم النسخ' : 'نسخ RIP'}</span>
                      </button>
                    </div>
                    <p className="text-xs text-slate-300">
                      المبلغ المطلوب تحويله: <strong className="text-amber-300">{checkoutProduct.price.toLocaleString('ar-DZ')} د.ج</strong>
                    </p>
                  </div>
                ) : (
                  <div className="bg-rose-500/10 border border-rose-500/30 rounded-2xl p-4 space-y-3">
                    <div className="flex items-center justify-between text-xs text-rose-200">
                      <span className="font-bold">إرسال فوري عبر تطبيق RedotPay (Send via UID):</span>
                      <span className="bg-rose-400/20 px-2 py-0.5 rounded text-[11px]">0% عمولة</span>
                    </div>
                    <div className="bg-slate-950 border border-slate-800 rounded-xl p-3 flex items-center justify-between gap-2">
                      <div>
                        <span className="text-[11px] text-slate-400 block">معرف RedotPay UID الخاص بالبائع:</span>
                        <span className="font-mono text-base font-bold text-rose-300 tracking-wider">
                          {checkoutProduct.sellerRedotId}
                        </span>
                      </div>
                      <button
                        type="button"
                        onClick={() => handleCopy(checkoutProduct.sellerRedotId, 'redot')}
                        className="px-3 py-2 rounded-lg bg-rose-500/20 hover:bg-rose-500/30 text-rose-300 text-xs font-bold flex items-center gap-1.5 cursor-pointer"
                      >
                        {copiedText === 'redot' ? <Check className="w-4 h-4" /> : <Copy className="w-4 h-4" />}
                        <span>{copiedText === 'redot' ? 'تم النسخ' : 'نسخ UID'}</span>
                      </button>
                    </div>
                    <p className="text-xs text-slate-300">
                      المبلغ المطلوب: <strong className="text-rose-300">{convertDzdToUsdt(checkoutProduct.price)} USDT</strong> (ما يعادل {checkoutProduct.price.toLocaleString('ar-DZ')} د.ج)
                    </p>
                  </div>
                )}

                {/* نموذج تأكيد رقم الوصل وفتح التحميل */}
                <form onSubmit={handleConfirmPayment} className="space-y-4">
                  <div className="space-y-1.5">
                    <label className="text-xs font-bold text-slate-300 block">
                      أدخل رقم عملية التحويل (رقم الوصل في بريدي موب أو RedotPay) *
                    </label>
                    <input
                      type="text"
                      required
                      value={transactionId}
                      onChange={(e) => setTransactionId(e.target.value)}
                      placeholder={
                        paymentMethod === 'baridimob'
                          ? 'مثال: 002489562314'
                          : 'مثال: RP-99854123'
                      }
                      className="w-full bg-slate-950 border border-slate-800 focus:border-emerald-500 rounded-xl px-4 py-3 text-sm text-white outline-none"
                    />
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                      <label className="text-xs text-slate-400 block mb-1">
                        رقم الهاتف (اختياري لاستلام نسخة SMS)
                      </label>
                      <input
                        type="tel"
                        value={buyerPhone}
                        onChange={(e) => setBuyerPhone(e.target.value)}
                        placeholder="05 / 06 / 07 ..."
                        className="w-full bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2.5 text-xs text-white outline-none"
                      />
                    </div>

                    <div>
                      <label className="text-xs text-slate-400 block mb-1">
                        إرفاق صورة الوصل (اختياري)
                      </label>
                      <label className="w-full bg-slate-950 border border-dashed border-slate-700 hover:border-emerald-500 rounded-xl px-3.5 py-2.5 text-xs text-slate-300 flex items-center justify-center gap-2 cursor-pointer">
                        <Upload className="w-4 h-4 text-emerald-400" />
                        <span className="truncate">
                          {receiptFileName || 'اختر صورة الوصل'}
                        </span>
                        <input
                          type="file"
                          accept="image/*,.pdf"
                          className="hidden"
                          onChange={(e) => {
                            if (e.target.files?.[0]) {
                              setReceiptFileName(e.target.files[0].name);
                            }
                          }}
                        />
                      </label>
                    </div>
                  </div>

                  {paymentError && (
                    <p className="text-xs text-rose-400 bg-rose-500/10 border border-rose-500/20 p-3 rounded-xl">
                      {paymentError}
                    </p>
                  )}

                  <button
                    type="submit"
                    className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black py-4 rounded-2xl shadow-lg shadow-emerald-600/30 transition-all flex items-center justify-center gap-2 cursor-pointer"
                  >
                    <CheckCircle2 className="w-5 h-5" />
                    <span>تأكيد الدفع وتحميل المنتج فوراً</span>
                  </button>
                </form>
              </>
            ) : (
              /* شاشة نجاح الدفع والتحميل الفوري */
              <div className="text-center py-6 space-y-5">
                <div className="w-16 h-16 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto">
                  <CheckCircle2 className="w-10 h-10" />
                </div>

                <div className="space-y-2">
                  <h3 className="text-2xl font-black text-white">
                    تم تأكيد الدفع بنجاح! بارك الله فيك
                  </h3>
                  <p className="text-sm text-slate-300 max-w-md mx-auto">
                    أصبح المنتج <strong className="text-emerald-400">"{checkoutProduct.title}"</strong> جاهزاً للتحميل الفوري، كما تمت إضافته إلى قسم "مشترياتي".
                  </p>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-2xl p-4 text-xs space-y-1.5 text-slate-300 max-w-sm mx-auto">
                  <div className="flex justify-between">
                    <span>المبلغ المدفوع:</span>
                    <strong className="text-emerald-400">{checkoutProduct.price.toLocaleString('ar-DZ')} د.ج</strong>
                  </div>
                  <div className="flex justify-between">
                    <span>وسيلة الدفع:</span>
                    <strong>{paymentMethod === 'baridimob' ? 'بريدي موب' : 'ريدوت باي'}</strong>
                  </div>
                  <div className="flex justify-between">
                    <span>رقم المرجع:</span>
                    <strong className="font-mono">{transactionId.toUpperCase()}</strong>
                  </div>
                </div>

                <div className="flex flex-col sm:flex-row gap-3 pt-2">
                  <button
                    onClick={() => triggerDigitalDownload(checkoutProduct)}
                    className="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-black py-4 rounded-2xl flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/30 cursor-pointer"
                  >
                    <Download className="w-5 h-5" />
                    <span>تحميل الملف الرقمي الآن</span>
                  </button>
                  <button
                    onClick={() => {
                      setCheckoutProduct(null);
                      setActiveTab('purchases');
                    }}
                    className="px-6 py-4 rounded-2xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-sm cursor-pointer"
                  >
                    الذهاب إلى مشترياتي
                  </button>
                </div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* الفوتر (Footer) */}
      <footer className="border-t border-slate-800/80 bg-slate-950 mt-16 py-10 px-4">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-6 text-xs sm:text-sm text-slate-400">
          <div className="flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center text-white font-black">
              1C
            </div>
            <div>
              <p className="font-bold text-white">منصة وان كليك الجزائر (OneClick DZ)</p>
              <p className="text-xs text-slate-500">أول سوق جزائري مفتوح لبيع وشراء المنتجات الرقمية بالدينار الجزائري</p>
            </div>
          </div>

          <div className="flex flex-wrap items-center gap-3">
            <span className="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-amber-300 font-bold">
              BaridiMob (RIP / CCP)
            </span>
            <span className="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-rose-400 font-bold">
              RedotPay (USDT / DZD)
            </span>
            <span className="px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-emerald-400 font-bold">
              عملة العرض: د.ج (DZD)
            </span>
          </div>
        </div>
      </footer>
    </div>
  );
}
